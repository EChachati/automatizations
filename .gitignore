# ========================
#  Secrets — never commit these
# ========================

# Per-user secrets, generated by hand on each machine
dotfiles/.config/fish/conf.d/secrets.fish
ktemplated/**/secrets.*
**/*.secret
**/id_*
**/*.key
**/*.pem

# VPN profiles
*.ovpn
vpn/

# Real env files with secrets
.env
.env.local
.env.production

# ========================
#  Machine specific — generated by install-machine.sh
# ========================

# Display connector names are hardware specific
dotfiles/.config/hypr/config/machine.lua
.machine.local

# ========================
#  Runtime writes inside managed paths
# ========================
# These directories are allowlisted in config/managed-paths.list, which
# means sync.sh is allowed to see what lands in them. Anything an app
# writes at runtime has to be listed here, or the timer commits it.

# Written by fish on every shell start.
dotfiles/.config/fish/fish_variables
dotfiles/.config/fish/.gitignore

# Written by micro and its plugin installer.
dotfiles/.config/micro/buffers/
dotfiles/.config/micro/syntax/
dotfiles/.config/micro/bindings.json

# Written by VLC.
dotfiles/.config/vlc/vlc-qt-interface.conf

# Written by CachyOS tooling at runtime.
dotfiles/.config/cachyos/cachyos-hello/
dotfiles/.config/cachyos/cachyos-pi/

# ========================
#  Generated by Noctalia
# ========================
# These are rendered from the wallpaper, which is not in this repository.
# Noctalia rewrites them on startup, so a fresh install regenerates them.
# Tracking them would mean a commit on every wallpaper change.
dotfiles/.config/hypr/noctalia.lua
dotfiles/.config/kitty/themes/
dotfiles/.config/alacritty/themes/
dotfiles/.config/foot/themes/
dotfiles/.config/qt6ct/colors/
dotfiles/.config/gtk-3.0/noctalia.css
dotfiles/.config/gtk-4.0/noctalia.css
dotfiles/.config/gtk-4.0/thumbnail.png

# ========================
#  Editor swap files
# ========================
**/*.swp
**/*.swo
*~

# Archives
*.zip

# LocalStack runtime data
docker/localstack/volume/

# ========================
#  OS
# ========================
.DS_Store
Thumbs.db
