# Lista de apps del menu. Pon false para OCULTAR, true para MOSTRAR.
# Tras editar, ejecuta: ~/.config/noctalia/hide-apps.sh
# Para refrescar esta lista: ~/.config/noctalia/sync-hidden-apps.sh
#
# Formato:  <id.desktop> = false|true     # Nombre
#
avahi-discover.desktop                        = false  # Avahi Zeroconf Browser
bssh.desktop                                  = false  # Avahi SSH Server Browser
btop.desktop                                  = true   # btop++
btrfs-assistant.desktop                       = false  # Btrfs Assistant
bvnc.desktop                                  = false  # Avahi VNC Server Browser
cachyos-hello.desktop                         = false  # CachyOS Hello
cachyos-pi.desktop                            = false  # CachyOS Package Installer
com.interversehq.qView.desktop                = false  # qView
com.obsproject.Studio.desktop                 = true   # OBS Studio
com.shellyorg.shelly.desktop                  = true   # Shelly
dev.lemmy.swash.desktop                       = false  # Swash
dev.noctalia.Noctalia.desktop                 = false  # Noctalia
discord.desktop                               = true   # Discord
kitty.desktop                                 = true   # kitty
limine-snapper-restore.desktop                = true   # Limine-snapper-restore
localsend.desktop                             = true   # LocalSend
lstopo.desktop                                = false  # Hardware Locality lstopo
micro.desktop                                 = true   # Micro
nvidia-settings.desktop                       = true   # NVIDIA X Server Settings
nwg-look.desktop                              = false  # GTK Settings
obsidian.desktop                              = true   # Obsidian
org.cachyos.KernelManager.desktop             = false  # CachyOS Kernel Manager
org.cachyos.scx-manager.desktop               = false  # SchedExt GUI Manager
org.gnome.Calculator.desktop                  = true   # Calculator
org.gnome.TextEditor.desktop                  = false  # Text Editor
org.kde.dolphin.desktop                       = true   # Dolphin
org.kde.krita.desktop                         = true   # Krita
org.pulseaudio.pavucontrol.desktop            = false  # Volume Control
qt6ct.desktop                                 = false  # Qt6 Settings
qv4l2.desktop                                 = false  # Qt V4L2 test Utility
qvidcap.desktop                               = false  # Qt V4L2 video capture utility
steam.desktop                                 = true   # Steam
transmission-qt.desktop                       = true   # Transmission (Qt)
uuctl.desktop                                 = false  # uuctl
vim.desktop                                   = true   # Vim
vlc.desktop                                   = true   # VLC media player
vscodium.desktop                              = false  # VSCodium
vscodium-wayland.desktop                      = true   # VSCodium - Wayland
zen.desktop                                   = true   # Zen Browser
